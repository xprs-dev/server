[Unit]
Description=XPRS server edition (Reticulum transport, LAN bridge, web chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xprs
Group=xprs
# The core keeps its tree under $HOME/.local/share/xprs: give the server its own.
Environment=HOME=/var/lib/xprs-server
StateDirectory=xprs-server
StateDirectoryMode=0700
WorkingDirectory=/var/lib/xprs-server
ExecStart=/opt/xprs-server/xprs-server --http-port 80
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=1G
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
